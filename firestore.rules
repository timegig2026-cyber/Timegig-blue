rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'timegig2026@gmail.com' ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // Gigs Collection
    match /gigs/{gigId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(gigId);
      allow update: if isSignedIn() && (isOwner(resource.data.ownerId) || isOwner(request.resource.data.ownerId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(resource.data.ownerId) || isAdmin());
    }

    // Applications Collection
    match /applications/{applicationId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.applicantId) || 
        get(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(applicationId);
      allow update, delete: if isSignedIn() && (isOwner(resource.data.applicantId) || isAdmin());
    }

    // Profiles Collection
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Hire Requests Collection
    match /hire_requests/{requestId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.seekerId) || 
        isOwner(resource.data.hirerId) ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isOwner(resource.data.seekerId) || 
        isOwner(resource.data.hirerId) ||
        isAdmin()
      );
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Subscription Payments Collection
    match /subscription_payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
